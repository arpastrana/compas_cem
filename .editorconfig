# Editor defaults that agree with the pre-commit hooks and with ruff's line length.

root = true

[*]
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 4
charset = utf-8
max_line_length = 180

[*.py]
max_line_length = 88

[*.{yml,yaml}]
indent_size = 2
